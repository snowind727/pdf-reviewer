# DeepSeek API（当前项目固定使用 DeepSeek V4 Flash）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# 以下为可选覆盖；通常只需要修改上面的 API Key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# 邀请码门禁（必填）：未配置时应用会拒绝访问
# 支持多个邀请码，逗号分隔，方便分发给不同人
INVITE_CODE=换成你自己的邀请码
# 用于签名登录态 Cookie 的密钥，可用 `openssl rand -hex 32` 生成
GATE_SECRET=换成随机生成的密钥
